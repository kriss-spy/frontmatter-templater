{
  "name": "frontmatter-templater",
  "version": "1.0.0",
  "description": "Simple inherited folder templates for Obsidian, configured from folder-note frontmatter.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "version": "node version-bump.mjs"
  },
  "keywords": [
    "obsidian",
    "templates",
    "folder-notes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
